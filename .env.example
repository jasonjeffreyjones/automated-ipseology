# Preferred local analysis-ready source. Never point this at the raw wide export.
IPSEITY_LOCAL_DATA=/home/ubuntu/ipseity-daily/data/ipseity.csv.gz

# Optional HTTPS fallback. Leave blank when local-only acquisition is desired.
IPSEITY_DATA_URL=
DATA_SOURCE=auto
MAX_DATA_AGE_DAYS=3

# Required: exact configured model identifier, also shown in article byline.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=1800
R_TIMEOUT_SECONDS=600

BASE_URL=https://jasonjones.ninja/automated-ipseology/

GIT_PUSH=true
GIT_REMOTE=origin
GIT_BRANCH=main

# Required for publication. Use a dedicated directory, not a web root.
DEPLOY_TARGET=
RSYNC_ARGS=-az --delete-delay --delay-updates --partial
